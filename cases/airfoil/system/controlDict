/*--------------------------------*- C++ -*----------------------------------*\
| poly2d example case -- steady incompressible RANS around the NACA 0012       |
| Target: OpenFOAM (foundation) v11+ modular solver `foamRun`.                  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         2000;          // SIMPLE iterations

deltaT          1;

writeControl    timeStep;
writeInterval   500;

purgeWrite      2;

writeFormat     ascii;
writePrecision  7;

writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   50;
        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1;         // incompressible -> kinematic
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        CofR            (0 0 0);
        pitchAxis       (0 0 1);
        magUInf         30;
        lRef            1;         // chord
        Aref            0.05;      // chord * span (span = extrusion thickness)
    }
}

// ************************************************************************* //
