/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Freestream along +x; the airfoil geometry is pre-rotated by 10 deg,
// so this already realises a 10 deg angle of attack.
internalField   uniform (30 0 0);

boundaryField
{
    farfield
    {
        type            freestreamVelocity;
        freestreamValue uniform (30 0 0);
    }
    airfoil
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
