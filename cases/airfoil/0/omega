/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

// omega = sqrt(k)/(Cmu^0.25 * L),  L ~ 0.1 c
internalField   uniform 6.7;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform 6.7;
    }
    airfoil
    {
        type            omegaWallFunction;
        value           uniform 6.7;
    }
    frontAndBack
    {
        type            empty;
    }
}

