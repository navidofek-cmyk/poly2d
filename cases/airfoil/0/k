/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// k = 1.5*(I*U)^2 with I = 1 %, U = 30 m/s
internalField   uniform 0.135;

boundaryField
{
    farfield
    {
        type            freestream;
        freestreamValue uniform 0.135;
    }
    airfoil
    {
        type            kqRWallFunction;
        value           uniform 0.135;
    }
    frontAndBack
    {
        type            empty;
    }
}

